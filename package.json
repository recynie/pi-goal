{
  "name": "@recynie/pi-goal",
  "version": "0.1.0",
  "description": "A Pi Goal mode with collaborative refinement and independent workspace verification.",
  "type": "module",
  "license": "MIT",
  "author": "recynie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recynie/pi-goal.git"
  },
  "homepage": "https://github.com/recynie/pi-goal#readme",
  "bugs": {
    "url": "https://github.com/recynie/pi-goal/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "goal",
    "verification"
  ],
  "files": [
    "src",
    "docs",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typebox": "1.3.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
